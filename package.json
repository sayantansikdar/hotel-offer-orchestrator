{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregates hotel offers from two suppliers with Temporal, dedupes by name, caches in Redis and filters by price.",
  "private": true,
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/temporal/bundle.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postman": "newman run postman/hotel-offer-orchestrator.postman_collection.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/common": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.26.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "newman": "^6.2.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
