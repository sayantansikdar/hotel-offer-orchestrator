PORT=3000
LOG_LEVEL=info
# Where the worker reaches the mock supplier endpoints (they live inside the API service)
SUPPLIER_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=3000
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
PARTIAL_CACHE_TTL_SECONDS=30
# Start with a supplier already down (true/false) to test the partial-result path
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
