# Single-container build for hosts that run one container per service (Render
# free tier). Bundles the Temporal dev server and Redis next to the API and the
# worker; docker-compose.yml is still the reference setup.

FROM temporalio/temporal:1.10.1 AS temporal

# redis-server plus the two OpenSSL libraries it links against, gathered in one
# folder so the copy below works on any architecture.
FROM redis:7-bookworm AS redis
RUN mkdir /out \
  && cp /usr/local/bin/redis-server /out/ \
  && cp /lib/$(uname -m)-linux-gnu/libssl.so.3 /lib/$(uname -m)-linux-gnu/libcrypto.so.3 /out/

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
COPY --from=redis /out/ /opt/redis/
COPY --from=temporal /usr/local/bin/temporal /usr/local/bin/temporal
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
COPY --chown=node:node deploy/start-all-in-one.sh ./start.sh
USER node
ENV PORT=10000
EXPOSE 10000
CMD ["./start.sh"]
