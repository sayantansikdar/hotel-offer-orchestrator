  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health - all up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('overall status ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('reports both suppliers', () => {",
                  "  pm.expect(body.suppliers['Supplier A'].status).to.eql('up');",
                  "  pm.expect(body.suppliers['Supplier B'].status).to.eql('up');",
                  "});",
                  "pm.test('reports redis and temporal', () => {",
                  "  pm.expect(body.dependencies.redis.status).to.eql('up');",
                  "  pm.expect(body.dependencies.temporal.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
