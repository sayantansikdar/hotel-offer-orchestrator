    {
      "name": "3. Hotels",
      "item": [
        {
          "name": "Valid city with overlaps (delhi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const hotels = pm.response.json();",
                  "pm.test('returns a non-empty array', () => pm.expect(hotels).to.be.an('array').that.is.not.empty);",
                  "",
                  "pm.test('every item has the response shape', () => {",
                  "  pm.response.json().forEach((h) => {",
                  "    pm.expect(h).to.have.all.keys('name', 'price', 'supplier', 'commissionPct');",
                  "    pm.expect(h.price).to.be.a('number');",
                  "    pm.expect(h.supplier).to.be.oneOf(['Supplier A', 'Supplier B']);",
                  "  });",
                  "});",
                  "",
                  "pm.test('hotel names are de-duplicated', () => {",
                  "  const names = hotels.map((h) => h.name.toLowerCase());",
                  "  pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "pm.test('picks the cheaper supplier for overlapping hotels', () => {",
                  "  const holtin = hotels.find((h) => h.name === 'Holtin');",
                  "  pm.expect(holtin).to.eql({ name: 'Holtin', price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
                  "  const radison = hotels.find((h) => h.name === 'Radison');",
                  "  pm.expect(radison).to.eql({ name: 'Radison', price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
                  "});",
                  "pm.test('keeps hotels only one supplier has', () => {",
                  "  pm.expect(hotels.map((h) => h.name)).to.include.members(['Lemon Leaf', 'Orchid Suites']);",
                  "});",
                  "pm.test('sorted by price ascending', () => {",
                  "  const prices = hotels.map((h) => h.price);",
                  "  pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "});",
                  "pm.test('ran a Temporal workflow', () => pm.response.to.have.header('X-Workflow-Id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          }
