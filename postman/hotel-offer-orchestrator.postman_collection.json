              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const hotels = pm.response.json();",
                  "",
                  "pm.test('every item has the response shape', () => {",
                  "  pm.response.json().forEach((h) => {",
                  "    pm.expect(h).to.have.all.keys('name', 'price', 'supplier', 'commissionPct');",
                  "    pm.expect(h.price).to.be.a('number');",
                  "    pm.expect(h.supplier).to.be.oneOf(['Supplier A', 'Supplier B']);",
                  "  });",
                  "});",
                  "",
                  "pm.test('all prices within 4000-6000', () => {",
                  "  pm.expect(hotels).to.not.be.empty;",
                  "  hotels.forEach((h) => pm.expect(h.price).to.be.within(4000, 6000));",
                  "});",
                  "pm.test('exactly the expected hotels', () => {",
                  "  pm.expect(hotels.map((h) => h.name)).to.eql(['Orchid Suites', 'Holtin', 'Radison']);",
                  "});",
                  "pm.test('served from the Redis cache', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));"
                ]
              }
            }
